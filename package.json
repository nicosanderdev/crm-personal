{
  "name": "crm-personal",
  "private": true,
  "workspaces": ["shared", "api", "web", "mobile"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w api\" \"npm run dev -w web\"",
    "dev:mobile": "npm run start -w mobile",
    "build": "npm run build -w web",
    "create-user": "npm run create-user -w api",
    "start": "npm run start -w api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
